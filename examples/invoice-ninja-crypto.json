        660,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "2d8ae1a7-956d-5853-a72c-54c56e33e4f5",
              "leftValue": "={{ $json.amount }}",
              "operator": {
                "type": "number",
