{
  "name": "n8n-nodes-cigalpay",
  "version": "1.1.0",
  "description": "n8n nodes for CigalPay: create crypto checkouts, read payments, refund, and trigger workflows from signed payment notifications.",
  "keywords": [
    "n8n-community-node-package",
    "cigalpay",
    "crypto",
    "payments",
    "bitcoin",
    "usdt"
  ],
  "license": "MIT",
  "homepage": "https://cigalpay.com/developers",
  "author": {
    "name": "CigalPay",
    "email": "support@cigalpay.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cigalpay/n8n-nodes-cigalpay.git"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "n8n-node build && node --test test/*.test.js"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/CigalPayApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/CigalPay/CigalPay.node.js",
      "dist/nodes/CigalPay/CigalPayTrigger.node.js"
    ],
    "strict": true
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.56.1",
    "@types/node": "^20.0.0",
    "eslint": "^9.32.0",
    "n8n-workflow": "*",
    "prettier": "^3.6.2",
    "typescript": "~5.6.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
